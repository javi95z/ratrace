{
  "expo": {
    "name": "The Rat Race",
    "slug": "theratrace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hackio.theratrace"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141b33",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hackio.theratrace",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_WIFI_STATE"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-localization",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "The Rat Race saves the picture of your life to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141b33",
          "image": "./assets/splash-mascot.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_continue": {
              "foregroundImage": "./assets/shortcuts/shortcut_continue.png",
              "backgroundColor": "#141b33"
            },
            "shortcut_challenge": {
              "foregroundImage": "./assets/shortcuts/shortcut_challenge.png",
              "backgroundColor": "#141b33"
            },
            "shortcut_new": {
              "foregroundImage": "./assets/shortcuts/shortcut_new.png",
              "backgroundColor": "#141b33"
            },
            "shortcut_rankings": {
              "foregroundImage": "./assets/shortcuts/shortcut_rankings.png",
              "backgroundColor": "#141b33"
            }
          }
        }
      ]
    ],
    "scheme": "theratrace",
    "backgroundColor": "#141b33",
    "extra": {
      "eas": {
        "projectId": "6a550ec5-0a6f-42d7-ad3c-db48820f3f73"
      }
    },
    "owner": "javi95z",
    "experiments": {
      "chunking": {
        "mode": "granular"
      }
    }
  }
}
