{
  "name": "@ratrace/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sprites": "tsx scripts/sprites.ts",
    "pwa": "tsx scripts/pwa.ts",
    "predev": "tsx scripts/sprites.ts && tsx scripts/pwa.ts",
    "dev": "next dev -p 3010",
    "prebuild": "tsx scripts/sprites.ts && tsx scripts/pwa.ts",
    "build": "next build",
    "postbuild": "tsx scripts/pwa.ts --build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@ratrace/content": "workspace:*",
    "@ratrace/engine": "workspace:*",
    "@supabase/supabase-js": "2.117.2",
    "idb": "^8.0.4",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3"
  }
}
