# The game is fully playable with this file missing: it then never touches the network.
# To play online, copy this file to .env.local and fill in the two values from the Supabase
# dashboard (Project Settings, API). Both are public by design and are sent to the browser.
#
# Never put the secret key (sb_secret_... or service_role) here or anywhere in this repository.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. The region the Supabase project is in (for example ap-northeast-1 for Tokyo). Named,
# a ranked life asks for its function there, next to the database: each step is one long hop
# instead of several. Left out, everything still works.
NEXT_PUBLIC_SUPABASE_REGION=

# Optional. The site key of a Cloudflare Turnstile widget (public by design). Named, the game asks
# Turnstile for proof that a person is there before it signs a guest in. Set it together with
# "Enable CAPTCHA protection" (Turnstile, with the widget's secret key) under Authentication in the
# Supabase dashboard: one without the other signs no new guest in. Left out, there is no guard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
