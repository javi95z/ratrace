# What EAS uploads for a build: the repo as git sees it (this file replaces .gitignore for EAS, so it repeats it),
# without what the app's build never reads: the raw art, the docs and their shots.

node_modules
dist
.DS_Store
*.tsbuildinfo
art/preview/
.worktrees/
.next/
playwright-report/
test-results/

# Local settings and keys: never committed. `.env.example` files say which values exist.
.env
.env.*
!.env.example
.vercel
# Generated from the current routes, public assets and production chunks.
apps/web/public/sw.js

# apps/mobile/.gitignore, anchored here
apps/mobile/**/node_modules/
apps/mobile/**/.expo/
apps/mobile/**/dist/
apps/mobile/**/web-build/
apps/mobile/**/expo-env.d.ts
apps/mobile/**/.kotlin/
apps/mobile/**/*.orig.*
apps/mobile/**/*.jks
apps/mobile/**/*.p8
apps/mobile/**/*.p12
apps/mobile/**/*.key
apps/mobile/**/*.mobileprovision
apps/mobile/**/.metro-health-check*
apps/mobile/**/npm-debug.*
apps/mobile/**/yarn-debug.*
apps/mobile/**/yarn-error.*
apps/mobile/**/.DS_Store
apps/mobile/**/*.pem
apps/mobile/**/.env*.local
apps/mobile/**/*.tsbuildinfo
apps/mobile/ios
apps/mobile/android
apps/mobile/assets/sprites/
apps/mobile/public/sprites/
apps/mobile/src/rules/v*.js
apps/mobile/public/rules/
apps/mobile/.kit-shots/
apps/mobile/.perf/

# Not needed to build the app (its sprites come from art/clean)
art/raw/
art/contact/
art/preview/
docs/

# Local working folders (kept out of git by .git/info/exclude)
.superpowers/
**/.claude/
