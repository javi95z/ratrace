# What EAS Build is not sent (with this file, EAS reads no .gitignore: their rules are repeated here). The app's build needs the packages, the
# app, the clean art (`pnpm sprites`), the web's older rules (`pnpm rules`) and the lockfile; never the raw art, the reports or the tools' output.

# As .gitignore
node_modules
dist
.DS_Store
*.tsbuildinfo
art/preview/
.worktrees/
.next/
playwright-report/
test-results/
.env
.env.*
!.env.example
.vercel
apps/web/public/sw.js
.claude/
.superpowers/

# As apps/mobile/.gitignore
apps/mobile/.expo/
apps/mobile/web-build/
apps/mobile/expo-env.d.ts
apps/mobile/.kotlin/
apps/mobile/ios/
apps/mobile/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
apps/mobile/.kit-shots/
apps/mobile/assets/sprites/
apps/mobile/public/sprites/
apps/mobile/public/rules/
apps/mobile/src/rules/v*.js

# Not needed to build the app: the art before it is cleaned, the contact sheets, the reports, their screenshots and the store's pictures.
art/raw/
art/contact/
docs/
supabase/functions/_shared/game/
