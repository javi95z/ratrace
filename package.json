{
  "name": "ratrace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p packages/content && tsc --noEmit -p tools/art && tsc --noEmit -p tools/balance && tsc --noEmit -p tools/play && tsc --noEmit -p tools/online && pnpm --filter @ratrace/web typecheck",
    "art": "pnpm --filter @ratrace/art-tool build-art",
    "balance": "pnpm --filter @ratrace/balance balance",
    "play": "pnpm --filter @ratrace/play play",
    "dev": "pnpm --filter @ratrace/web dev",
    "build": "pnpm --filter @ratrace/web build",
    "e2e": "pnpm --filter @ratrace/web e2e",
    "online:test-db": "pnpm --filter @ratrace/online-tools test-db",
    "online:bundle": "pnpm --filter @ratrace/online-tools bundle",
    "online:live-check": "pnpm --filter @ratrace/online-tools live-check",
    "online:deploy": "pnpm online:bundle && supabase functions deploy engine finish-run ranked --use-api && pnpm online:bundle --shipped",
    "catalog": "pnpm --filter @ratrace/play catalog"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
